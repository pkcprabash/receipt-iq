# Copy to `.env` (gitignored) and fill in real values before running
# docker-compose.prod.yml. Never commit the filled-in file.

POSTGRES_PASSWORD=
# A random 32+ byte string — e.g. `openssl rand -base64 48`. Must differ from the
# dev-only key in appsettings.Development.json.
JWT_SIGNING_KEY=

# Optional: leave blank to keep using FakeReceiptExtractor / NoOpCategoryClassifier.
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
